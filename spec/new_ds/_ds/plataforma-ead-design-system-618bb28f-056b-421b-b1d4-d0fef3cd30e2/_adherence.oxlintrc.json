        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|tonal|secondary|ghost|success|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'tonal' | 'secondary' | 'ghost' | 'success' | 'danger'."
